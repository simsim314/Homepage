---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import { getContent } from '../lib/content';
interface Props {
  type: 'research' | 'project';
  title: string;
  description: string;
}
const { type, title, description } = Astro.props;
const { articles } = await getContent();
const selected = articles.filter((a) => a.data.type === type);
---

<Base title={title} description={description}
  ><section class="container page-intro">
    <span class="eyebrow">The journal / {title}</span><h1>{title}.</h1><p>{description}</p><span
      class="eyebrow">{selected.length} articles from the shared collection</span
    >
  </section><section class="container section">
    <div class="article-grid">{selected.map((a) => <ArticleCard article={a} />)}</div>
  </section></Base
>
