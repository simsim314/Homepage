---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import TopicNavigation from './TopicNavigation.astro';
import { getContent } from '../lib/content';
interface Props {
  type: 'research' | 'project';
  title: string;
  description: string;
}
const { type, title, description } = Astro.props;
const { articles, interests } = await getContent();
const selected = articles.filter((a) => a.data.type === type);
---

<Base title={title} description={description}
  ><section class="container page-intro">
    <span class="eyebrow">The journal / {title}</span><h1>{title}.</h1><p>{description}</p><span
      class="eyebrow">{selected.length} articles from the shared collection</span
    >
  </section><section class="container section topic-layout">
    <aside class="topic-sidebar">
      <TopicNavigation interests={interests} articles={articles} />
    </aside>
    <div class="topic-content">
      <div class="article-grid">{selected.map((a) => <ArticleCard article={a} preview />)}</div>
    </div>
  </section></Base
>
