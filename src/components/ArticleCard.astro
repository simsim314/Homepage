---
import type { Article } from '../lib/content';
import ArticleVisual from './ArticleVisual.astro';
import ProjectImage from './ProjectImage.astro';
import { articleHref, statusLabels, formatDate } from '../lib/content';
interface Props {
  article: Article;
  compact?: boolean;
  preview?: boolean;
  previewId?: string;
}
const {
  article,
  compact = false,
  preview = false,
  previewId = `preview-${article.id}`,
} = Astro.props;
const { data } = article;
const hasPreview = preview && data.showPreview;
---

<article
  class:list={['article-card', { compact, 'has-preview': hasPreview }]}
  data-article-id={article.id}
>
  {
    hasPreview && (
      <a
        class="card-image"
        id={previewId}
        href={articleHref(article)}
        aria-label={`Read ${data.title}`}
      >
        {data.image ? (
          <ProjectImage src={data.image} alt={data.imageAlt || data.title} />
        ) : (
          <ArticleVisual id={article.id} kind={data.visual} instance={previewId} />
        )}
      </a>
    )
  }
  <div class="card-copy">
    <div class="eyebrow">
      <span>{data.type === 'research' ? 'Research' : 'Project'}</span><span
        class={`status-dot status-${data.status}`}></span><span>{statusLabels[data.status]}</span>
    </div>
    <h3><a href={articleHref(article)}>{data.title}<span aria-hidden="true"> ↗</span></a></h3>
    <p>{data.description}</p>
    <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
  </div>
</article>
