---
import { href } from '../lib/content';
interface Props {
  file: string;
  alt: string;
  caption: string;
}
const { file, alt, caption } = Astro.props;
const url = href(`images/life-tiles/${file}`);
---

<figure class="tile-schematic">
  <a href={url} target="_blank" rel="noopener" aria-label={`Open full-size diagram: ${alt}`}>
    <img src={url} alt={alt} loading="lazy" decoding="async" />
  </a>
  <figcaption>
    {caption}
    <a href={url} target="_blank" rel="noopener">Full-size diagram ↗</a>
  </figcaption>
</figure>
<style>
  .tile-schematic {
    margin: 2rem 0;
  }
  .tile-schematic img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
  }
  .tile-schematic figcaption {
    margin-top: 0.6rem;
    font: 0.75rem/1.6 var(--sans);
    color: var(--muted);
  }
</style>
