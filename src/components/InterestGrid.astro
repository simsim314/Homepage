---
import type { CollectionEntry } from 'astro:content';
import type { Article } from '../lib/content';
import InterestCard from './InterestCard.astro';
interface Props {
  interests: CollectionEntry<'interests'>[];
  articles: Article[];
}
const { interests, articles } = Astro.props;
const primaryInterests = interests.filter((interest) => !interest.data.parent);
---

<div
  class:list={[
    'interest-grid',
    {
      'balanced-thirds': primaryInterests.length % 3 === 0,
      'balanced-last-pair': primaryInterests.length % 3 !== 0 && primaryInterests.length % 4 === 2,
    },
  ]}
>
  {
    primaryInterests.map((interest, index) => (
      <InterestCard
        interest={interest}
        number={index + 1}
        count={articles.filter((article) => article.data.topics.includes(interest.id)).length}
        representative={articles.find((article) => article.id === interest.data.representative)}
        children={interests.filter((child) => child.data.parent === interest.id)}
      />
    ))
  }
</div>
