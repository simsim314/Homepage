---
import Base from '../layouts/Base.astro';
import ProjectImage from '../components/ProjectImage.astro';
import LifeDemo from '../components/LifeDemo.astro';
import InterestGrid from '../components/InterestGrid.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicNavigation from '../components/TopicNavigation.astro';
import { site } from '../lib/site';
import { getContent, href, articleHref } from '../lib/content';
const { articles, interests } = await getContent();
const heroArticle = articles.find((a) => a.data.homepageHero);
---

<Base>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-square"></span> A personal research journal</p><h1>
        Engaging curiosity.<br /><em>Making ideas work.</em>
      </h1><p class="hero-description">{site.introduction}</p><p class="hero-note">
        Curiosity, experimentation, and engineering: building tools, testing ideas, and getting
        results. This journal follows that work in AI, mathematics, and cellular automata.
      </p><div class="hero-actions">
        <a class="button" href="#interests"
          >Explore my interests <span aria-hidden="true">↓</span></a
        ><a class="text-link" href={href('about/')}>A little about me ↗</a>
      </div>
    </div>{
      heroArticle && (
        <div class="hero-exhibit" id={`preview-${heroArticle.id}`} data-article-id={heroArticle.id}>
          {heroArticle.id === 'simkin-glider-gun' ? (
            <>
              <LifeDemo hero autoplay linked />
              <p class="exhibit-note">
                A few cells. An endless stream of gliders.{' '}
                <a href={href('articles/simkin-glider-gun/#glider-gun')}>Read the story ↗</a>
              </p>
            </>
          ) : (
            heroArticle.data.image && (
              <>
                <a
                  class="hero-project-image"
                  href={articleHref(heroArticle)}
                  aria-label={`Read about ${heroArticle.data.title}`}
                >
                  <ProjectImage
                    src={heroArticle.data.image}
                    alt={heroArticle.data.imageAlt || heroArticle.data.title}
                    eager
                  />
                </a>
                <p class="exhibit-note">
                  <a href={articleHref(heroArticle)}>{heroArticle.data.title} ↗</a>
                </p>
              </>
            )
          )}
        </div>
      )
    }
  </section>
  <section id="interests" class="section interests-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">01 / Explore</span><h2>Explore the work.</h2></div><p>
          Different interests. Connected ideas.<br />Choose a starting point.
        </p>
      </div><InterestGrid interests={interests} articles={articles} />
    </div>
  </section>
  <section id="articles" class="section articles-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">02 / The journal</span><h2>Recent articles.</h2></div><p>
          Research, projects, and experiments<br />in one growing collection.
        </p>
      </div><div class="topic-layout">
        <aside class="topic-sidebar">
          <TopicNavigation interests={interests} articles={articles} allActive />
        </aside>
        <div class="topic-content">
          <div class="journal-controls">
            <span class="eyebrow">All topics</span>
            <span id="article-count">{articles.length} articles</span>
          </div><div class="journal-list">
            {
              articles.map((a) => (
                <div
                  class="journal-entry"
                  id={`article-${a.id}`}
                  data-topics={a.data.topics.join(' ')}
                >
                  <ArticleCard article={a} preview previewId={`journal-preview-${a.id}`} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="container about-strip">
    <span class="eyebrow">03 / About & contact</span><h2>Building is part of the research.</h2><p>
      I explore ideas by building tools and constructions, running experiments, and working toward
      results—from glider-gun searches to GPU chess and mathematical proofs.
    </p><div>
      <a class="button" href={href('about/')}>More about me ↗</a><a
        class="text-link"
        href={`mailto:${site.email}`}>Contact me by email ↗</a
      >
    </div>
  </section>
</Base>
