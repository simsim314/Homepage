---
import Base from '../layouts/Base.astro';
import LifeDemo from '../components/LifeDemo.astro';
import InterestGrid from '../components/InterestGrid.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site } from '../lib/site';
import { getContent, href } from '../lib/content';
const { articles, interests } = await getContent();
const featured = articles.filter((a) => a.data.featured);
const featuredNotes = featured.filter((a) => !a.data.showPreview);
const featuredCards = featured.filter((a) => a.data.showPreview);
---

<Base>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-square"></span> A personal research journal</p><h1>
        Simple rules.<br />Unexpected <em>possibilities.</em>
      </h1><p class="hero-description">{site.introduction}</p><p class="hero-note">
        This journal also follows my discoveries in Conway’s Game of Life, the tools behind them,
        and other computational experiments.
      </p><div class="hero-actions">
        <a class="button" href="#interests"
          >Explore my interests <span aria-hidden="true">↓</span></a
        ><a class="text-link" href={href('about/')}>A little about me ↗</a>
      </div>
    </div><div class="hero-exhibit" id="glider-gun">
      <LifeDemo hero /><p class="exhibit-note">
        A few cells. An endless stream of gliders. <a href={href('articles/simkin-glider-gun/')}
          >Read the story ↗</a
        >
      </p>
    </div>
  </section>
  <section id="interests" class="section interests-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">01 / Explore</span><h2>Follow your curiosity.</h2></div><p>
          Different interests. Connected ideas.<br />Choose a starting point.
        </p>
      </div><InterestGrid interests={interests} articles={articles} />
    </div>
  </section>
  <section class="container section" id="featured">
    <div class="section-heading">
      <div><span class="eyebrow">02 / Selected work</span><h2>A closer look.</h2></div><a
        class="text-link"
        href="#articles">Browse all articles ↗</a
      >
    </div>{
      featuredNotes.length > 0 && (
        <div class="featured-notes">
          {featuredNotes.map((a) => (
            <ArticleCard article={a} />
          ))}
        </div>
      )
    }<div class="featured-grid">
      {featuredCards.map((a) => <ArticleCard article={a} preview={a.id !== 'simkin-glider-gun'} />)}
    </div>
  </section>
  <section id="articles" class="section articles-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">03 / The journal</span><h2>Recent articles.</h2></div><p>
          Research, projects, and experiments<br />in one growing collection.
        </p>
      </div><div class="journal-controls">
        <label
          >Filter by interest<select id="topic-filter"
            ><option value="all">All interests</option>{
              interests.map((i) => <option value={i.id}>{i.data.title}</option>)
            }</select
          ></label
        ><span id="article-count" role="status">{articles.length} articles</span>
      </div><div class="journal-list">
        {
          articles.map((a) => (
            <div class="journal-entry" id={`article-${a.id}`} data-topics={a.data.topics.join(' ')}>
              <ArticleCard
                article={a}
                compact
                preview={!a.data.featured && a.id !== 'simkin-glider-gun'}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="container about-strip">
    <span class="eyebrow">04 / About & contact</span><h2>Curiosity is the common thread.</h2><p>
      From searching for a glider gun to exploring deep fractals, this is a place for the work and
      the questions behind it.
    </p><div>
      <a class="button" href={href('about/')}>More about me ↗</a><a
        class="text-link"
        href="https://github.com/simsim314">Find me on GitHub ↗</a
      >
    </div>
  </section>
</Base>
<script>
  const filter = document.querySelector<HTMLSelectElement>('#topic-filter');
  filter?.addEventListener('change', () => {
    let count = 0;
    document.querySelectorAll<HTMLElement>('.journal-entry').forEach((el) => {
      el.hidden = filter.value !== 'all' && !el.dataset.topics!.split(' ').includes(filter.value);
      if (!el.hidden) count++;
    });
    document.querySelector('#article-count')!.textContent =
      `${count} ${count === 1 ? 'article' : 'articles'}`;
  });
</script>
